# Copy this file to .env and fill in real values.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://propai_app:change-me@localhost:5432/propai
# Optional. JSON list of frontend origins allowed to call the API.
CORS_ORIGINS=["http://localhost:5173"]
# AI agent: free key from https://aistudio.google.com (never commit the real key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Chat rate limits: messages per visitor per minute, and for the whole site per day.
CHAT_PER_MINUTE=5
CHAT_PER_DAY=200
# Booking rate limits: visits per visitor per hour, and for the whole site per day.
VISITS_PER_HOUR=3
VISITS_PER_DAY=100
