# Copy this file to .env and fill in real values.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://propai_app:change-me@localhost:5432/propai
# Optional. JSON list of frontend origins allowed to call the API.
CORS_ORIGINS=["http://localhost:5173"]
# AI agent: free key from https://aistudio.google.com (never commit the real key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite